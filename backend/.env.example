# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://localhost:27017/greensync

# JWT Authentication
JWT_SECRET=your_jwt_secret_placeholder
JWT_EXPIRES_IN=7d

# Demo Mode
# Set DEMO_MODE=true to force deterministic simulated energy curves without external calls
DEMO_MODE=false

# Third-Party / India Energy Atlas (IEA) API Configuration
# Base URL must be the bare origin (https://api.energymap.in) with NO /developer/v1 suffix - the code appends versioned paths itself
ENERGY_API_BASE_URL=https://api.energymap.in

# Real API key from https://www.energymap.in/settings#api-keys (format iea_live_...)
# Note: Even the free Sandbox tier is sufficient for current conditions and carbon-intensity-based forecasts,
# just not for fuel-mix or demand forecasts.
ENERGY_API_KEY=your_energy_api_key_placeholder

# Optional India Energy Atlas provider overrides (defaults shown)
# CARBON_INTENSITY_DIRTY_GCO2_KWH=950
# CARBON_INTENSITY_CLEAN_GCO2_KWH=300
# GRID_DEMAND_MIN_MW=120000
# GRID_DEMAND_MAX_MW=260000
# LIVE_DATA_CACHE_TTL_MINUTES=15
# ENERGY_API_MAX_RETRIES=3
